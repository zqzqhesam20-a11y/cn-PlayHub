}


/*
 * =====================================================
 * بطاقة اللعبة
 * =====================================================
 */

@Composable
fun GameCard(
    game: Game,
    usbUri: Uri?,
    onMessage: (String) -> Unit
) {

    Card(
        modifier =
            Modifier.fillMaxWidth(),
        shape =
            RoundedCornerShape(18.dp),
        colors =
            CardDefaults.cardColors(
                containerColor =
                    Color(0xFF141D18)
            ),
        elevation =
            CardDefaults.cardElevation(
                defaultElevation =
                    5.dp
            )
    ) {

        Column(
            modifier =
                Modifier.padding(10.dp),
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {

            Box(
                modifier =
                    Modifier
                        .fillMaxWidth()
                        .height(135.dp)
                        .background(
                            Color(0xFF0D130F),
                            RoundedCornerShape(
                                14.dp
                            )
                        ),
                contentAlignment =
                    Alignment.Center
            ) {

                Image(
                    painter =
                        painterResource(
                            id =
                                game.image
                        ),
                    contentDescription =
                        game.name,
                    modifier =
                        Modifier.size(
                            120.dp
                        ),
                    contentScale =
                        ContentScale.Fit
                )
            }

            Spacer(
                modifier =
                    Modifier.height(9.dp)
            )

            Text(
                text =
                    game.name,
                color =
                    Color.White,
                fontSize =
                    17.sp,
                fontWeight =
                    FontWeight.Bold,
                textAlign =
                    TextAlign.Center
            )

            Spacer(
                modifier =
                    Modifier.height(3.dp)
            )

            Text(
                text =
                    game.englishName,
                color =
                    Color(0xFF9AA69E),
                fontSize =
                    11.sp,
                textAlign =
                    TextAlign.Center
            )

            Spacer(
                modifier =
                    Modifier.height(9.dp)
            )

            Button(
                onClick = {

                    if (usbUri == null) {

                        onMessage(
                            "⚠ اختر الفلاشة أولاً"
                        )

                    } else {

                        onMessage(
                            "جاري البحث عن مجلد العابي..."
                        )

                        CoroutineScope(
                            Dispatchers.IO
                        ).launch {

                            val result =
                                findGameFolder(
                                    usbUri,
                                    game.sourceFolder
                                )

                            MainActivityHolder
                                .activity
                                ?.runOnUiThread {

                                    onMessage(
                                        result
                                    )
                                }
                        }
                    }
                },
                modifier =
                    Modifier.fillMaxWidth(),
                shape =
                    RoundedCornerShape(11.dp),
                colors =
                    ButtonDefaults.buttonColors(
                        containerColor =
                            Color(0xFF689F38)
                    )
            ) {

                Text(
                    text =
                        "نسخ اللعبة",
                    color =
                        Color.White,
                    fontWeight =
                        FontWeight.Bold
                )
            }

            Spacer(
                modifier =
                    Modifier.height(5.dp)
            )

            Button(
                onClick = {

                    onMessage(
                        "التثبيت سيتم إضافته في المرحلة التالية"
                    )
                },
                modifier =
                    Modifier.fillMaxWidth(),
                shape =
                    RoundedCornerShape(11.dp),
                colors =
                    ButtonDefaults.buttonColors(
                        containerColor =
                            Color(0xFF26332B)
                    )
            ) {

                Text(
                    text =
                        "تثبيت التطبيق",
                    color =
                        Color.White,
                    fontSize =
                        12.sp
                )
            }
        }
    }
}


/*
 * =====================================================
 * البحث عن اللعبة داخل:
 *
 * جذر الفلاشة / العابي
 * =====================================================
 */

fun findGameFolderDocument(
    usbUri: Uri?,
    gameFolderName: String
): DocumentFile? {

    if (usbUri == null) {
        return null
    }

    return try {

        val activity =
            MainActivityHolder.activity
                ?: return null

        val root =
            DocumentFile.fromTreeUri(
                activity,
                usbUri
            )
                ?: return null

        val gamesFolder =
            root.findFile("العابي")
                ?: return null

        if (!gamesFolder.isDirectory) {
            return null
        }

        val gameFolder =
            gamesFolder.findFile(gameFolderName)

        if (
            gameFolder != null &&
            gameFolder.isDirectory
        ) {
            gameFolder
        } else {
            null
        }

    } catch (e: Exception) {
        null
    }
}

fun findGameFolder(
    usbUri: Uri?,
    gameFolderName: String
): String {

    if (usbUri == null) {
        return "⚠ لم يتم اختيار الفلاشة"
    }

    return try {

        val activity =
            MainActivityHolder.activity
                ?: return "⚠ التطبيق غير جاهز"

        val root =
            DocumentFile.fromTreeUri(
                activity,
                usbUri
            )

        if (root == null) {
            return "⚠ تعذر الوصول إلى الفلاشة"
        }

        val gamesFolder =
            root.findFile(
                "العابي"
            )

        if (
            gamesFolder == null ||
            !gamesFolder.isDirectory
        ) {

            return "❌ لم يتم العثور على مجلد العابي في جذر الفلاشة"
        }

        val gameFolder =
            gamesFolder.findFile(
                gameFolderName
            )

        if (
            gameFolder == null ||
            !gameFolder.isDirectory
        ) {

            return "❌ لم يتم العثور على:\n$gameFolderName"
        }

        "✓ تم العثور على:\n${gameFolder.name}"

    } catch (e: Exception) {

        "❌ خطأ:\n${e.message}"
    }
}


/*
 * =====================================================
 * مرجع MainActivity
 * =====================================================
 */

object MainActivityHolder {

    var activity: MainActivity? = null
}
