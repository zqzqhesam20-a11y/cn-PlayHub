import rikka.shizuku.Shizuku


class MainActivity : ComponentActivity() {

    companion object {
        const val SHIZUKU_PERMISSION_CODE = 100
    }

    /*
     * ==========================
     * Shizuku Permission Listener
     * ==========================
     */

    private val shizukuPermissionListener =
        Shizuku.OnRequestPermissionResultListener {
                requestCode,
                grantResult ->

            if (requestCode == SHIZUKU_PERMISSION_CODE) {
                recreate()
            }
        }

    /*
     * ==========================
     * Shizuku Binder Received
     * ==========================
     */

    private val shizukuBinderReceivedListener =
        Shizuku.OnBinderReceivedListener {

            runOnUiThread {
                recreate()
            }
        }

    /*
     * ==========================
     * Shizuku Binder Dead
     * ==========================
     */

    private val shizukuBinderDeadListener =
        Shizuku.OnBinderDeadListener {

            runOnUiThread {
                recreate()
            }
        }


    override fun onCreate(
        savedInstanceState: Bundle?
    ) {

        super.onCreate(savedInstanceState)

        MainActivityHolder.activity = this


        /*
         * تسجيل مستمع الصلاحية
         */

        Shizuku.addRequestPermissionResultListener(
            shizukuPermissionListener
        )


        /*
         * مراقبة اتصال Shizuku
         */

        Shizuku.addBinderReceivedListener(
            shizukuBinderReceivedListener
        )


        /*
         * مراقبة انقطاع Shizuku
         */

        Shizuku.addBinderDeadListener(
            shizukuBinderDeadListener
        )


        setContent {

            KafiaNetApp()
        }
    }


    override fun onDestroy() {

        Shizuku.removeRequestPermissionResultListener(
            shizukuPermissionListener
        )

        Shizuku.removeBinderReceivedListener(
            shizukuBinderReceivedListener
        )

        Shizuku.removeBinderDeadListener(
            shizukuBinderDeadListener
        )

        MainActivityHolder.activity = null

        super.onDestroy()
    }
}


/*
 * =====================================================
 * بيانات الألعاب
 * =====================================================
 */

data class Game(
    val name: String,
    val englishName: String,
    val image: Int,
    val sourceFolder: String,
    val targetPath: String
)


/*
 * =====================================================
 * التطبيق
 * =====================================================
 */

@Composable
fun KafiaNetApp() {

    var usbUri by remember {
        mutableStateOf<Uri?>(null)
    }

    var message by remember {
        mutableStateOf(
            "اختر الفلاشة للبدء"
        )
    }


    /*
     * =================================================
     * اختيار جذر الفلاشة
     * =================================================
     */

    val folderPicker =
        rememberLauncherForActivityResult(
            contract =
                ActivityResultContracts.OpenDocumentTree()
        ) { uri ->

            if (uri != null) {

                usbUri = uri

                try {

                    val flags =
                        Intent.FLAG_GRANT_READ_URI_PERMISSION or
                                Intent.FLAG_GRANT_WRITE_URI_PERMISSION

                    MainActivityHolder
                        .activity
                        ?.contentResolver
                        ?.takePersistableUriPermission(
                            uri,
                            flags
                        )

                    message =
                        "✓ تم تحديد الفلاشة"

                } catch (e: Exception) {

                    message =
                        "✓ تم تحديد الفلاشة"
                }
            }
        }


    /*
     * =================================================
     * الألعاب
     * =================================================
     */

    val games = listOf(

        Game(
            name = "فورتنايت",
            englishName = "Fortnite",
            image = R.drawable.fortnite,
            sourceFolder =
                "فورتنايت (Fortnite)",
            targetPath =
                "Android/data/com.epicgames.fortnite"
        ),

        Game(
            name = "جينشن إمباكت",
            englishName =
                "Genshin Impact",
            image =
                R.drawable.genshin,
            sourceFolder =
                "جينشن امباكت (Genshin Impact)",
            targetPath =
                "سيتم تحديده لاحقاً"
        ),

        Game(
            name = "بيس",
            englishName =
                "eFootball™",
            image =
                R.drawable.efootball,
            sourceFolder =
                "بيس (eFootball™)",
            targetPath =
                "Android/data + Android/obb"
        ),

        Game(
            name = "فري فاير",
            englishName =
                "Free Fire",
            image =
                R.drawable.freefire,
            sourceFolder =
                "فري فاير (Free Fire)",
            targetPath =
                "Android/data/com.dts.freefireth"
        ),

        Game(
            name = "ببجي موبايل",
            englishName =
                "PUBG Mobile",
            image =
                R.drawable.pubg,
            sourceFolder =
                "ببجي (PUBG)",
            targetPath =
                "Android/data/com.tencent.ig/files/UE4Game/ShadowTrackerExtra/ShadowTrackerExtra/saved"
        ),

        Game(
            name = "كول أوف ديوتي",
            englishName =
                "Call of Duty",
            image =
                R.drawable.callofduty,
            sourceFolder =
                "كول اوف ديوتي (Call of Duty)",
            targetPath =
                "Android/data/com.activision.callofduty.shooter"
        ),

        Game(
            name = "جراند ثفت أوتو",
            englishName =
                "Grand Theft Auto",
            image =
                R.drawable.gta,
            sourceFolder =
                "جراند ثفت أوتو (Grand Theft Auto)",
            targetPath =
                "سيتم تحديده حسب إصدار GTA"
        )
    )


    /*
     * =================================================
     * فحص Shizuku
     * =================================================
     */

    val shizukuAvailable =
        Shizuku.pingBinder()

    val shizukuPermission =
        shizukuAvailable &&
                Shizuku.checkSelfPermission() ==
                PackageManager.PERMISSION_GRANTED


    /*
     * =================================================
     * واجهة التطبيق
     * =================================================
     */

    MaterialTheme {

        Column(
