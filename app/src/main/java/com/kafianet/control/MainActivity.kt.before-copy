                            end = 18.dp,
                            top = 22.dp,
                            bottom = 16.dp
                        ),
                horizontalAlignment =
                    Alignment.CenterHorizontally
            ) {

                Text(
                    text =
                        "كافية نت",
                    color =
                        Color.White,
                    fontSize =
                        36.sp,
                    fontWeight =
                        FontWeight.Bold
                )

                Text(
                    text =
                        "هشام الريمي",
                    color =
                        Color(0xFF8BC34A),
                    fontSize =
                        17.sp,
                    modifier =
                        Modifier.padding(
                            top = 4.dp
                        )
                )

                Spacer(
                    modifier =
                        Modifier.height(12.dp)
                )


                /*
                 * Shizuku
