/*
 * =====================================================
 * بطاقة Shizuku
 * =====================================================
 */

@Composable
fun ShizukuCard(
    available: Boolean,
    permission: Boolean
) {

    Card(
        modifier =
            Modifier.fillMaxWidth(),
        shape =
            RoundedCornerShape(14.dp),
        colors =
            CardDefaults.cardColors(
                containerColor =
                    Color(0xFF17231B)
            )
    ) {

        Column(
            modifier =
                Modifier.padding(12.dp),
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {

            Text(
                text =
                    "Shizuku",
                color =
                    Color.White,
                fontSize =
                    17.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Spacer(
                modifier =
                    Modifier.height(4.dp)
            )

            val status =
                when {

                    !available ->
                        "● غير متصل"

                    !permission ->
                        "● متصل - الصلاحية مطلوبة"

                    else ->
                        "● متصل والصلاحية مفعلة"
                }

            Text(
                text =
                    status,
                color =
                    when {

                        !available ->
                            Color(0xFFE57373)

                        !permission ->
                            Color(0xFFFFB74D)

                        else ->
                            Color(0xFF8BC34A)
                    },
                fontSize =
                    13.sp
            )


            /*
             * طلب صلاحية Shizuku
             */

            if (
                available &&
                !permission
            ) {

                Spacer(
                    modifier =
                        Modifier.height(8.dp)
                )

                Button(
                    onClick = {

                        Shizuku.requestPermission(
                            MainActivity
                                .SHIZUKU_PERMISSION_CODE
                        )
                    },
                    shape =
                        RoundedCornerShape(
                            10.dp
                        ),
                    colors =
                        ButtonDefaults.buttonColors(
                            containerColor =
                                Color(0xFF689F38)
                        )
                ) {

                    Text(
                        text =
                            "طلب صلاحية Shizuku",
                        fontWeight =
                            FontWeight.Bold
                    )
                }
            }
        }
    }
}


